# Ambiente local: development. No Render, use production.
NODE_ENV=development
# Porta HTTP do servidor Node.
PORT=4000
# URL do PostgreSQL local ou remoto.
DATABASE_URL=postgresql://auction:auction@localhost:5432/verzel_auction
# Segredo aleatório com pelo menos 32 bytes para assinar sessões de login.
JWT_SECRET=
# Segredo aleatório estável com pelo menos 32 bytes para assinar a cabeça de auditoria.
AUDIT_SECRET=
# true em HTTPS de produção; false no HTTP local.
COOKIE_SECURE=false
# Origem autorizada. Localmente use o host do Vite; em produção pode usar RENDER_EXTERNAL_URL.
APP_ORIGIN=http://localhost:5173
# Senha opcional para contas de demonstração criadas pela primeira vez.
DEMO_PASSWORD=
# true se o PostgreSQL remoto exigir TLS.
DATABASE_SSL=false
# Limite de conexões do pool Node.
DB_POOL_SIZE=10
